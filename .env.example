APP_ENV=development
APP_SECRET_KEY=development-only-change-me
DATABASE_URL=postgresql+psycopg://secworkflow:secworkflow@db:5432/secworkflow
# Legacy fallback only; normally manage Git allowlists in the UI per Workspace.
ALLOWED_TARGETS=
WORKSPACE_ROOT=/workspace

# Optional LLM for ai.explain
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=1400

# Legacy fallback only; normally manage webhook host allowlists in the UI per Workspace.
NOTIFY_WEBHOOK_ALLOWED_HOSTS=webhook.site

# CI / schedule tokens as needed
CI_TRIGGER_TOKEN=
TEMPLATE_PUBLISH_TOKEN=

ALLOWED_ORIGINS=

# Legacy fallback; preferred setup is the encrypted workspace integration settings in the UI.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs (legacy fallback)
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional explicit master-key file. Docker generates and persists a key automatically by default.
MASTER_KEY_FILE=
# Optional SOCKS5/HTTP proxy for Bot API, e.g. socks5://user:pass@host:port
TELEGRAM_PROXY=
