POSTGRES_DB=secworkflow
POSTGRES_USER=secworkflow
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+psycopg://secworkflow:change-me-local@db:5432/secworkflow
APP_ENV=development
APP_SECRET_KEY=replace-with-random-secret
MASTER_KEY_HEX=
# Or mount a Docker secret and set MASTER_KEY_FILE=/run/secrets/master_key
ALLOWED_TARGETS=https://github.com/OWNER/REPOSITORY
# Exact hostnames allowed for HTTPS webhook delivery; comma-separated. Empty disables notifications.
WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# Add each exact HTTPS owner/repository URL you intend to clone; comma-separated.
WORKSPACE_ROOT=/workspace
# Optional OpenAI-compatible endpoint (HTTPS required except localhost)
# Example: https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Exact public HTTPS hosts allowed for outbound notifications (comma-separated)
NOTIFY_WEBHOOK_ALLOWED_HOSTS=webhook.site

# Optional dedicated bearer secret for the GitHub Actions CI trigger API
CI_TRIGGER_TOKEN=

# Optional dedicated secret required to publish workflows to the shared template library
TEMPLATE_PUBLISH_TOKEN=

# Exact browser origins, comma-separated. Required when APP_ENV=production.
ALLOWED_ORIGINS=


# Telegram notifications (token never stored in workflow JSON)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids allowed for notify.telegram
TELEGRAM_ALLOWED_CHAT_IDS=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Comma-separated exact SMTP hostnames allowed for outbound mail
SMTP_ALLOWED_HOSTS=
